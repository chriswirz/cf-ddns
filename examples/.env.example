# Copy to .env next to docker-compose.yml and fill in.
# Compose reads this file automatically; it is not baked into the image.

# Cloudflare API token with Zone:Read and DNS:Edit on the zones below.
# Create one at https://dash.cloudflare.com/profile/api-tokens
# ("Edit zone DNS" is exactly the right template.)
CF_API_TOKEN=

# Comma separated record names to keep pointed at this host's public IP.
# Leave empty on the first run to have cf-ddns write a possible_records
# section into the volume listing every A and AAAA record the token can see.
CF_DDNS_RECORDS=home.example.com,www.example.com

# A for IPv4, AAAA for IPv6.
CF_DDNS_TYPE=A

# Whether Cloudflare proxies the record (the orange cloud).
CF_DDNS_PROXIED=false

# How often to check the public IP, in seconds. Minimum 30.
CF_DDNS_INTERVAL=300

# Log every check, not just changes.
CF_DDNS_VERBOSE=false

# A release tag such as v0.1.0, or latest.
CF_DDNS_RELEASE=latest
